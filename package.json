{
  "name": "@openapi-typescript-infra/create",
  "version": "0.0.0",
  "description": "Project generator for @openapi-typescript-infra services",
  "type": "module",
  "exports": {
    ".": "./build/index.js",
    "./api": "./build/apiProject.js",
    "./handlers": "./build/handlers.js",
    "./actions": "./build/actions.js",
    "./prompts": "./build/prompts.js"
  },
  "author": "Max Metral <developers@pyralis.com>",
  "license": "MIT",
  "config": {
    "coconfig": "@openapi-typescript-infra/coconfig"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "echo \"TODO: write tests\" && exit 0",
    "clean": "yarn dlx rimraf ./build",
    "lint": "eslint src",
    "postinstall": "coconfig"
  },
  "bin": "./build/index.js",
  "publishConfig": {
    "access": "public"
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/npm",
      "@semantic-release/github"
    ]
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": "yarn eslint src --cache --fix"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@openapi-typescript-infra/coconfig": "^4.7.1",
    "@semantic-release/github": "^11.0.1",
    "@types/configstore": "^6.0.2",
    "@types/handlebars-helpers": "^0.5.6",
    "@types/minimist": "^1.2.5",
    "@types/node": "^22.14.1",
    "@types/parse-git-config": "^3.0.4",
    "@types/pascalcase": "^1.0.3",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "coconfig": "^2.0.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^4.3.2",
    "eslint-plugin-import": "^2.31.0",
    "pinst": "^3.0.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3"
  },
  "packageManager": "yarn@3.5.1",
  "dependencies": {
    "@readme/openapi-parser": "^2.7.0",
    "boxen": "^8.0.1",
    "configstore": "^7.0.0",
    "handlebars-helpers": "^0.10.0",
    "minimist": "^1.2.8",
    "mkdirp": "^3.0.1",
    "openapi-types": "^12.1.3",
    "parse-git-config": "^3.0.0",
    "plop": "^4.0.1",
    "plop-pack-git-init": "^0.3.1"
  }
}
